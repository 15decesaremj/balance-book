{
  "name": "balance-book-mvp",
  "version": "1.1.2",
  "productName": "Balance Book",
  "author": "Balance Book contributors",
  "license": "MIT",
  "private": true,
  "description": "Local-first financial operations desktop application for Windows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/15decesaremj/balance-book.git"
  },
  "bugs": {
    "url": "https://github.com/15decesaremj/balance-book/issues"
  },
  "homepage": "https://github.com/15decesaremj/balance-book#readme",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "start": "electron-forge start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests --pool=threads --maxWorkers=1",
    "test:watch": "vitest tests",
    "pretest:e2e": "electron-forge package",
    "test:e2e": "playwright test --config playwright.config.ts",
    "privacy:check": "node tools/privacy-check/index.mjs",
    "public:mirror": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-public-mirror.ps1",
    "public:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/sync-public-mirror.ps1",
    "public:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/assemble-public-release.ps1",
    "published:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-published-status.ps1",
    "build:icon": "node tools/build-icon.mjs",
    "build": "pnpm build:icon && electron-forge package",
    "package": "pnpm build:icon && electron-forge package",
    "make": "pnpm build:icon && electron-forge make",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-windows-release.ps1",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "@balance-book/database": "workspace:*",
    "@balance-book/domain": "workspace:*",
    "@balance-book/financial-engine": "workspace:*",
    "@fluentui/react-components": "9.74.3",
    "@hookform/resolvers": "5.4.0",
    "@js-temporal/polyfill": "0.5.1",
    "better-sqlite3": "12.11.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-router": "8.2.0",
    "recharts": "3.9.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "electron": "43.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
