#include <windows.h>

#ifndef APP_VERSION_MAJOR
#define APP_VERSION_MAJOR 1
#endif
#ifndef APP_VERSION_MINOR
#define APP_VERSION_MINOR 0
#endif
#ifndef APP_VERSION_PATCH
#define APP_VERSION_PATCH 0
#endif
#ifndef APP_VERSION_BUILD
#define APP_VERSION_BUILD 0
#endif

#define STRINGIZE_INNER(value) #value
#define STRINGIZE(value) STRINGIZE_INNER(value)
#define APP_VERSION_TEXT                                                       \
  STRINGIZE(APP_VERSION_MAJOR) "." STRINGIZE(APP_VERSION_MINOR) "."          \
      STRINGIZE(APP_VERSION_PATCH) "." STRINGIZE(APP_VERSION_BUILD)

1 ICON "assets\\balance-book.ico"
1 RT_MANIFEST "tools\\windows-uninstaller\\uninstall-balance-book.manifest"

1 VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Balance Book contributors\0"
      VALUE "FileDescription", "Balance Book uninstaller\0"
      VALUE "FileVersion", APP_VERSION_TEXT "\0"
      VALUE "InternalName", "BalanceBookUninstaller\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Balance Book contributors\0"
      VALUE "OriginalFilename", "Uninstall Balance Book.exe\0"
      VALUE "ProductName", "Balance Book\0"
      VALUE "ProductVersion", APP_VERSION_TEXT "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
